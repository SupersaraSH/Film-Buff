<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Film buff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/common.css">
    <link rel="stylesheet" href="/stylesheets/movies.css">
  </head>
  <body>
    <%- include('modules/navbar') %>
    <main>
      <section class="section-movies py-5">
        <div class="container-xxl">
          <h2 class="pb-4">ALL OUR MOVIES</h2>
          <form class="pb-2">
            <p>Order the movies:</p>
            <input
              type="radio" 
              name="option_grp" 
              value="/movies?filter=arrival" 
              id="arrival" 
              class="btn-check"
              checked>
            <label class="me-2 mb-3 btn btn-outline-primary" for="arrival">by arrival</label>

            <input 
              type="radio" 
              name="option_grp" 
              value="/movies?filter=title" 
              id="title" 
              class="btn-check"
              <%= filter=='title'?'checked': '' %> >
            <label class="me-2 mb-3 btn btn-outline-primary" for="title">by title</label>

            <input 
              type="radio" 
              name="option_grp" 
              id="rating"  
              value="/movies?filter=rating"
              class="btn-check"
              <%= filter=='rating'?'checked': '' %>>
            <label class="me-2 mb-3 btn btn-outline-primary" for="rating">by rating</label>

            <input 
              type="radio" 
              name="option_grp" 
              id="release_year"  
              value="/movies?filter=release_year" 
              class="btn-check"
              <%= filter=='release_year'?'checked': ''%>>
            <label class="me-2 mb-3 btn btn-outline-primary" for="release_year">by release year</label>
          </form>

          <div class="row gap-4 justify-content-center">
            <% films.forEach((film)=>{ %>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
              <div class="mx-auto movie-box">
                <a href="/movies/movie/<%= film.film_id %>">
                  <img class="w-100" src="/images/movies/<%= film.poster?film.poster:'film.png' %>"
                  alt="film image">
                </a>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
    <%- include('modules/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <script src="/javascripts/filter.js"></script>
  </body>
</html>