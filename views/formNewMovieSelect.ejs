<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Film buff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/common.css">
    <link rel="stylesheet" href="/stylesheets/newMovie.css">
  </head>
  <body>
    <%- include('modules/navbar') %>
    <h2>New Movie</h2>

    <section class="section-new">
      <div class="container-xxl">
        <div class="row">
          <div class="col">
            <div class="d-flex justify-content-center">
              <form 
                class="w-25 border border-1 rounded-2 m-5 p-2"
                action="/movies/addMovieSelect"
                method="post"
                enctype="multipart/form-data"
                >
                <div class="mb-3">
                  <label for="inputTitle" class="form-label"
                    >Select a user</label
                  >
                  <select 
                    class="form-select" 
                    aria-label="Default select example"
                    name="user_id"
                  >
                  <option value="" selected disabled>Select a user</option>
                  <% users.forEach((user)=>{ %>
                      <option 
                      value="<%= user.user_id %>">
                        <%= user.user_name %> <%= user.last_name %>
                      </option>
                  <% }) %>
              </select>
                </div>
              <div class="mb-3">
                <label for="inputTitle" class="form-label"
                  >Title:</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputTitle"
                    aria-describedby="title"
                    name="title"
                  />
                </div>
              <div class="mb-3">
                <label for="inputReview" class="form-label"
                  >Review:</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputReview"
                    aria-describedby="review"
                    name="review"
                  />
                </div>
              <div class="mb-3">
                <label for="iputRrating" class="form-label"
                >Rating</label
                >
                <input
                type="text"
                class="form-control"
                id="iputRrating"
                aria-describedby="ratingHelp"
                name="rating"
                />
                </div>
                <div class="mb-3">
                  <label for="inputFormat" class="form-label"
                    >Format</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="inputFormat"
                    aria-describedby="formatHelp"
                    name="format"
                  />
                </div>
                <div class="mb-3">
                    <label for="inputRelease" class="form-label"
                    >Release year</label
                    >
                    <input
                    type="text"
                    class="form-control"
                    id="inputRelease"
                    aria-describedby="release_yearHelp"
                    name="release_year"
                    />
                </div>
              
                <div class="mb-3">
                  <label for="inputPoster" class="form-label">Image</label>
                  <input
                    type="file"
                    class="form-control"
                    id="inputPoster"
                    name="img"
                  />
                </div>
                <p class="msg-err"><%= typeof message != 'undefined'?message:null %></p>
                <div class="d-flex justify-content-center gap-5">
                  <button type="submit" class="btn" >Aceptar</button>
                  <button
                  type="button"
                  onclick="window.location.href='/'"
                  class="btn"
                  >Cancelar</button>
                  <button
                  type="reset"
                  class="btn"
                  >Limpiar</button>
                </div>
              </form>
            </div>
            
          </div>
        </div>
      </div>
    </section>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
  </body>
</html>