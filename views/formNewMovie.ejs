<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Film buff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/common.css">
    <link rel="stylesheet" href="/stylesheets/newMovie.css">
  </head>
  <body>
    <%- include('modules/navbar') %>
    <main>
      <section class="section-new">
        <div class="container-xxl">
          <div class="row">
            <div class="col">
              <div class="d-flex justify-content-center">
                <form
                  class="border border-1 rounded-2 m-5 p-4"
                  action="/movies/addMovie/<%= user_id %>"
                  method="post"
                  enctype="multipart/form-data"
                >
                <h2 class="mb-3">Add movie</h2>
                <div class="mb-3">
                  <label for="inputTitle" class="form-label">Title:</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputTitle"
                    name="title"
                    value="<%= user?.title || '' %>"
                  />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "title")?.message %></p>
                </div>
                <div class="mb-3">
                  <label for="inputReview" class="form-label">Review:</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputReview"
                    name="review"
                    value="<%= user?.review || '' %>"
                  />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "review")?.message %></p>
                </div>
                <div class="mb-3">
                  <label for="iputRrating" class="form-label">Rating</label>
                  <input
                    type="text"
                    class="form-control"
                    id="iputRrating"
                    name="rating"
                    value="<%= user?.rating || '' %>"
                  />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "rating")?.message %></p>
                </div>
                <div class="mb-3">
                  <label for="inputFormat" class="form-label">Format</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputFormat"
                    name="format"
                    value="<%= user?.format || '' %>"
                  />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "format")?.message %></p>
                </div>
                <div class="mb-3">
                  <label for="inputRelease" class="form-label">Release year</label>
                  <input
                    type="text"
                    class="form-control"
                    id="inputRelease"
                    name="release_year"
                    value="<%= user?.release_year || '' %>"
                  />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "release_year")?.message %></p>
                </div>

                <div class="mb-1">
                  <label for="inputPoster" id="imgLabelPoster" class="form-label image">Add image</label>
                  <img id="imgPreviewPoster" class="d-none w-100 mb-2 cursor-pointer" alt="preview" style="max-height:200px;object-fit:contain;">
                  <input type="file" class="form-control d-none" id="inputPoster" name="img" />
                  <p class="msg-err"><%= errores?.find(e=>e.field === "file")?.message %></p>
                </div>

                  <div class="d-flex justify-content-center  gap-0 gap-sm-1 gap-lg-5">
                    <button type="submit" class="btn" >Aceptar</button>
                    <button
                      type="button"
                      onclick="window.location.href=`/users/userProfileToken/<%= user_id %>`"
                      class="btn"
                      >Cancelar
                    </button>
                    <button
                      type="reset"
                      class="btn"
                      >Limpiar
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <%- include('modules/footer') %>


    <script>
      const inputPoster = document.getElementById('inputPoster');
      const imgPreview = document.getElementById('imgPreviewPoster');
      const imgLabel = document.getElementById('imgLabelPoster');
      inputPoster.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        imgPreview.src = URL.createObjectURL(file);
        imgPreview.classList.remove('d-none');
        imgLabel.classList.add('d-none');
        imgPreview.onclick = () => inputPoster.click();
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
  </body>
</html>