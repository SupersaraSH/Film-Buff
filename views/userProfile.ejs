<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Film buff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/common.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
  </head>
  <body>
    <%- include('modules/navbar') %>
    
    <section class="section-user py-5">
      <div class="container-xxl">
        <div class="row">
          <div class="col-6">
            <div class="center">
              <img class="w-100" src="/images/users/<%= user.avatar?user.avatar:'default1.jpg' %>" alt="">
            </div>
          </div>
          <div class="col-6">
            <div>
              <p><%= user.user_name %> <%= user.last_name %></p>
              <p><%= user.email %></p>
              <p><%= user.description %></p>
              <a href="/movies/addMovie/<%= user.user_id %>" class="btn">Add Movie</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-movies py-5">
      <div class="container-xxl">
        <div class="row row-gap-5">
          <h2 class="mb-0">Movies</h2>
          <% films.forEach((film)=>{ %>
          <div class="col-4">
            <div class="card mx-auto">
              <img src="/images/movies/<%= film.poster?film.poster:'film.png' %>" 
              class="card-img-top" alt="film image">
              <div class="card-body">
                <h5 class="card-title">Title: <%= film.title %></h5>
                <p class="card-text">Review: <%= film.review %></p>
                <p class="card-text">Rating: <%= film.rating %></p>
                <p class="card-text">Format: <%= film.format %></p>
                <p class="card-text">Release year: <%= film.release_year %></p>
                <a href="/movies/editMovie/<%= film.film_id%>" class="btn">Edit Movie</a>
                <a href="/movies/delMovie/<%= film.film_id%>/<%=user.user_id%>/<%= film.poster?film.poster:'film.png' %>" class="btn">Delete Movie</a>
                <a href="/movies/delLogicMovie/<%= film.film_id%>/<%=user.user_id%>" class="btn">Delete logic</a>
              </div>
            </div>
          </div>
          <% }) %>

        </div>
      </div>
    </section>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
  </body>
</html>