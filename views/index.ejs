<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Film buff</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="/stylesheets/common.css">
    <link rel="stylesheet" href="/stylesheets/index.css">

  </head>
  <body>
    <%- include('modules/navbar') %>
    
    <main>
      <section class="section-movies">
        <article class="d-flex flex-column justify-content-end align-items-start w-75 ms-5">
          <div class="join-btn">
            <a href="/users/register" class="btn mb-2">Join Us</a>
          </div>
          <h1>Where movies bring people together</h1>
        </article>
      </section>
      
      <section class="section-addict py-5" id="addicts">
        <div class="container-xxl">
          <div class="row row-gap-5">
            <h2>Movie addicts</h2>
            <% users.forEach((user)=>{ %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="card mx-auto">
                <img src="/images/users/<%= user.avatar?user.avatar:'default1.jpg' %>"
                class="card-img-top" alt="user image">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title"><%= user.user_name %> <%= user.last_name %></h5>
                  <p class="card-text"><%= user.email %></p>
                  <p class="card-text"><%= user.description %></p>
                  <a href="/users/userProfile/<%= user.user_id %>" class="btn mt-auto align-self-end">See More</a>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
    <%- include('modules/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
  </body>
</html>